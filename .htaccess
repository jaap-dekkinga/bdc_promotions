# bedc.shop is served from a copy of this whole repo (it pulls main on every
# push), so without this file every repo file is public there: the pricing
# sheet, CLAUDE.md, .claude/, intent/ ... Only the storefront may be served.
# Everything else returns 404.
#
# Keep this list in step with "Collect storefront files" in
# .github/workflows/static.yml (the GitHub Pages copy). If index.html starts
# loading a file outside assets/, allow it in both places.

Options -Indexes
DirectoryIndex index.html

RewriteEngine On

# No path tricks: "..", "%2e" or "%2f" in the raw request path (not the
# query string) could otherwise reach a private file through ^assets/.
RewriteCond %{THE_REQUEST} ^\S+\s[^?\s]*(\.\.|%2e|%2f) [NC]
RewriteRule ^ - [R=404,L]

# The storefront
RewriteRule ^$ - [L]
RewriteRule ^index\.html$ - [L]
RewriteRule ^assets/ - [L]

# SSL renewals: Hostinger's edge answers these today, but keep the path
# open in case a renewal ever goes through to the site folder
RewriteRule ^\.well-known/acme-challenge/ - [L]

# Everything else
RewriteRule ^ - [R=404,L]
